# Copie para `.env` e ajuste. Nenhum valor aqui e um segredo real.

# Ambiente da aplicacao: development | test | production
APP_ENV=development

# Credenciais do Postgres do docker-compose
POSTGRES_USER=sgs
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=sgs

# Banco da aplicacao. Execucao local (venv): host `localhost`.
# O docker-compose sobrescreve o host para `db`.
DATABASE_URL=postgresql://sgs:troque-me@localhost:5432/sgs

# Banco da suite de testes — precisa ser diferente do de desenvolvimento (AD-012)
DATABASE_URL_TESTE=postgresql://sgs:troque-me@localhost:5432/sgs_test

# Chave de assinatura da aplicacao. Gere uma propria; nunca reutilize esta.
SECRET_KEY=troque-me

# Entrega de e-mail: log | smtp
EMAIL_BACKEND=log

# Origem do front, usada nas URLs dos e-mails e no proxy de desenvolvimento.
# Em `APP_ENV=production` precisa comecar com https://
URL_DO_FRONT=http://localhost:5173

# Limite do corpo de requisicao, em MB. Opcional; o padrao e 10.
TAMANHO_MAXIMO_DE_CORPO_MB=10
